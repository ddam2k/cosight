# Keycloak의 외부 접근 URL입니다. Realm 경로는 포함하지 않습니다.
COSIGHT_KEYCLOAK_URL=https://keycloak.example.com
COSIGHT_KEYCLOAK_REALM=cosight
COSIGHT_KEYCLOAK_CLIENT_ID=cosight-web

# 프런트에 전달할 공개 설정입니다. 비밀 값은 설정하지 않습니다.
COSIGHT_KEYCLOAK_SCOPE=openid profile email

# API 설정
COSIGHT_HTTP_ADDRESS=:8080
COSIGHT_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL 연결 정보. COSIGHT_POSTGRES_URL을 사용하면 아래 개별 연결 값보다 우선합니다.
# COSIGHT_POSTGRES_URL=postgres://cosight:change-me@127.0.0.1:5432/cosight?sslmode=disable
COSIGHT_POSTGRES_HOST=127.0.0.1
COSIGHT_POSTGRES_PORT=5432
COSIGHT_POSTGRES_USER=cosight
COSIGHT_POSTGRES_PASSWORD=change-me
COSIGHT_POSTGRES_DATABASE=cosight
COSIGHT_POSTGRES_SSLMODE=disable
COSIGHT_POSTGRES_MAX_OPEN_CONNS=20
COSIGHT_POSTGRES_MAX_IDLE_CONNS=5
COSIGHT_POSTGRES_CONN_MAX_LIFETIME=30m

# 선택 사항: issuer가 외부 URL과 다를 때만 명시합니다.
# COSIGHT_KEYCLOAK_ISSUER=https://keycloak.example.com/realms/cosight
